# ─────────────────────────────────────────────────────────────
# House of Paradox — environment variables
# Local:   fill these in .env.local (never commit it).
# Netlify: add the same names under Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase (stores every contact-form enquiry) ──
# Dashboard → Project Settings → API (or "API Keys")
SUPABASE_URL=
# The SECRET key (sb_secret_…), or the legacy "service_role" key. Server-only — never share it.
SUPABASE_SECRET_KEY=

# ── Email notifications (Resend, https://resend.com) ──
# Send-only key restricted to houseofparadoxproduction.com
RESEND_API_KEY=
# Who receives new-enquiry emails. Defaults to tushar@houseofparadoxproduction.com
# (set in src/config/site.ts). Only set this to override; comma-separate for several people.
CONTACT_NOTIFY_TO=
# Sender. Defaults to "House of Paradox Website <website@houseofparadoxproduction.com>"
# (src/config/site.ts). Only set this to override.
CONTACT_EMAIL_FROM=

# ── Analytics (optional; each one is off while empty) ──
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID (heatmaps + session recordings), e.g. abcd1234ef
NEXT_PUBLIC_CLARITY_ID=
# Google Search Console "HTML tag" verification code (only the content="…" value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
